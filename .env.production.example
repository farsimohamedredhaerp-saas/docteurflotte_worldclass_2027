# ==============================================================================
# DOCTEURFLOTTE 2027 — Modèle d'environnement de Production VPS (.env)
# ==============================================================================
# Copiez ce fichier sur votre VPS : cp .env.production.example .env
# Et personnalisez les secrets aléatoires (générés avec openssl rand -hex 32)
# ==============================================================================

# 1. Domaines & Noms d'Hôtes (Pointage DNS requis : A records vers IP de votre VPS)
DOMAIN_WEB=app.docteurflotte.dz
DOMAIN_API=api.docteurflotte.dz
DOMAIN_TRACCAR=traccar.docteurflotte.dz
PUBLIC_API_URL=https://api.docteurflotte.dz

# 2. Base de données PostgreSQL 16
POSTGRES_DB=docteurflotte_prod
POSTGRES_USER=docteurflotte_app
POSTGRES_PASSWORD=CHANGE_ME_SECRET_POSTGRES_STRONG_PASSWORD_2027

# 3. Cache & Files Redis 7
REDIS_PASSWORD=CHANGE_ME_SECRET_REDIS_STRONG_PASSWORD_2027

# 4. Sécurité & Authentification JWT
JWT_SECRET=CHANGE_ME_SECRET_JWT_KEY_MINIMUM_64_CHARACTERS_HEXADECIMAL

# 5. Serveur Télématique Traccar
TRACCAR_USER=admin
TRACCAR_PASSWORD=CHANGE_ME_TRACCAR_ADMIN_PASSWORD_2027
