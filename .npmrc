# ==============================================================================
# DOCTEURFLOTTE — Sécurité Supply Chain (.npmrc)
# ==============================================================================
# Verrouillage strict des versions de moteur Node.js
engine-strict=true

# Audit automatique des vulnérabilités lors de l'installation
audit=true

# Sauvegarde des dépendances avec versions exactes sans préfixe ^ ou ~
save-exact=true

# Restreindre l'exécution des scripts de build tiers aux seuls paquets certifiés
only-built-dependencies=@nestjs/core
