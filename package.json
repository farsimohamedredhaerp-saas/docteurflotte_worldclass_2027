{
  "name": "docteurflotte-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme SaaS decisionnelle, controle de gestion et maintenance des actifs operationnels",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @docteurflotte/api dev",
    "dev:web": "pnpm --filter @docteurflotte/web dev",
    "lint": "turbo run lint --concurrency=1",
    "lint:hardcode": "node scripts/guardrails/lint-decision-engine-hardcode.cjs",
    "bench": "pnpm --filter @docteurflotte/decision-engine build && node scripts/bench-decision-engine.cjs",
    "pack:sign": "node scripts/pack-cli.cjs sign",
    "pack:verify": "node scripts/pack-cli.cjs verify",
    "pack:generate-keys": "node scripts/pack-cli.cjs generate-keys",
    "typecheck": "turbo run typecheck --concurrency=1",
    "test": "turbo run test --concurrency=1",
    "sync:telemetry": "node --experimental-strip-types scripts/sync-open-telemetry-data.ts",
    "seed:maintenance": "node --experimental-strip-types prisma/seed-maintenance.ts",
    "seed:prisma": "npx prisma db seed",
    "simulate:dz": "node --experimental-strip-types scripts/simulate-dz-fleet.ts",
    "postinstall": "node scripts/patch-write-file-atomic.cjs",
    "verify": "node scripts/guardrails/verify-all.cjs"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed-maintenance.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
