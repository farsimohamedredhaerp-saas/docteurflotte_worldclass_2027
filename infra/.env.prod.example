# ==============================================================================
# DOCTEURFLOTTE 2027 — Modèle d'Environnement de Production Souveraine (On-Premise)
# Conforme Loi 18-07 ANPDP, Isolation Multi-Tenant RLS & Décret 03-223
# ==============================================================================

# 1. Base de Données PostgreSQL 16 & TimescaleDB
POSTGRES_USER=docteurflotte_app
POSTGRES_PASSWORD=Definir_Un_Mot_De_Passe_Robuste_Postgres_Ici_2027!
POSTGRES_DB=docteurflotte_prod
POSTGRES_PORT=5432

# 2. Cache & Message Broker Redis 7
REDIS_PASSWORD=Definir_Un_Mot_De_Passe_Robuste_Redis_Ici_2027!
REDIS_PORT=6379

# 3. Serveur Télématique IoT Traccar 6.x
TRACCAR_USER=admin
TRACCAR_PASSWORD=Definir_Un_Mot_De_Passe_Traccar_Ici_2027!
TRACCAR_WEBHOOK_SECRET=Definir_Un_Secret_Webhook_Traccar_2027!
FLESPI_WEBHOOK_TOKEN=

# 4. Sécurité, Sessions & Signatures Cryptographiques
# Générer avec : openssl rand -base64 32
JWT_SECRET=Cle_Secrete_Pour_Tokens_Jwt_DocteurFlotte_2027_Minimum_32_Caracteres!
MISSION_ORDER_SIGNING_SECRET=Cle_Secrete_Signature_Ordres_De_Mission_Qr_2027_Minimum_32_Car!

# 5. Domaines & Reverse Proxy Caddy (HTTPS Automatique)
DOMAIN_WEB=app.docteurflotte.dz
DOMAIN_API=api.docteurflotte.dz
DOMAIN_TRACCAR=traccar.docteurflotte.dz
DOMAIN_MAPS=maps.docteurflotte.dz
PUBLIC_API_URL=https://api.docteurflotte.dz

# 6. IA Souveraine Embarquée Ollama (Qwen 2.5 1.5B Instruct)
OLLAMA_PORT=11434

