{
  "$schema": "./tokens.schema.json",
  "version": "5.1.0",
  "name": "DocteurFlotte Design Tokens — Titanium & Sahara Calcite",
  "description": "Design Operating System v5.1 — Source unique de vérité pour le thème et l'architecture UI",
  "meta": {
    "prefix": "df",
    "outputDir": "./dist/tokens",
    "targets": ["css", "tailwind", "ts"],
    "defaultTheme": "light"
  },
  "primitives": {
    "spacing": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem"
    },
    "radius": {
      "xs": "4px",
      "sm": "6px",
      "md": "8px",
      "lg": "10px",
      "xl": "14px",
      "full": "9999px"
    },
    "zIndex": {
      "base": 0,
      "sticky": 10,
      "dropdown": 100,
      "overlay": 200,
      "modal": 300,
      "popover": 400,
      "toast": 500,
      "command": 600
    },
    "borderWidths": {
      "hairline": "1px",
      "medium": "1.5px",
      "thick": "2px"
    },
    "density": {
      "compact": 0.75,
      "comfort": 1,
      "spacious": 1.25
    },
    "motion": {
      "durations": {
        "fast": "120ms",
        "base": "200ms",
        "slow": "320ms",
        "xslow": "480ms"
      },
      "easings": {
        "outQuint": "cubic-bezier(0.22, 1, 0.36, 1)",
        "inOut": "cubic-bezier(0.65, 0, 0.35, 1)",
        "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
      }
    },
    "typography": {
      "fonts": {
        "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "mono": "'JetBrains Mono', 'Geist Mono', ui-monospace, SFMono-Regular, monospace",
        "arabic": "'Noto Sans Arabic', 'IBM Plex Sans Arabic', sans-serif"
      },
      "sizes": {
        "xs": "0.6875rem",
        "sm": "0.75rem",
        "base": "0.8125rem",
        "lg": "0.9375rem",
        "xl": "1.375rem",
        "2xl": "2rem"
      },
      "weights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      },
      "lineHeights": {
        "tight": 1.2,
        "snug": 1.35,
        "normal": 1.5,
        "relaxed": 1.625
      },
      "letterSpacings": {
        "tighter": "-0.02em",
        "tight": "-0.01em",
        "normal": "0",
        "wide": "0.025em",
        "wider": "0.05em"
      }
    }
  },
  "semantic": {
    "dark": {
      "bg": {
        "base": "#080A0F",
        "surface1": "#0D111A",
        "surface2": "#121824",
        "surface3": "#182030"
      },
      "border": {
        "hairline": "rgba(255, 255, 255, 0.08)",
        "subtle": "#1E2638",
        "medium": "#2A364F",
        "highlight": "rgba(255, 255, 255, 0.12)"
      },
      "text": {
        "primary": "#F8FAFC",
        "secondary": "#94A3B8",
        "muted": "#64748B",
        "faint": "#334155",
        "onBrand": "#FFFFFF"
      },
      "brand": {
        "primary": "#3B82F6",
        "primaryHover": "#60A5FA",
        "glow": "rgba(59, 130, 246, 0.22)"
      },
      "telemetry": {
        "cyan": "#0284C7",
        "cyanSubtle": "rgba(2, 132, 199, 0.12)"
      },
      "status": {
        "nominal": "#10B981",
        "nominalBg": "rgba(16, 185, 129, 0.10)",
        "warning": "#D97706",
        "warningBg": "rgba(217, 119, 6, 0.12)",
        "critical": "#DC2626",
        "criticalBg": "rgba(220, 38, 38, 0.12)",
        "neutral": "#64748B",
        "neutralBg": "rgba(100, 116, 139, 0.10)"
      },
      "shadows": {
        "card": "inset 0 1px 0 0 rgba(255, 255, 255, 0.08), 0 4px 12px -2px rgba(0, 0, 0, 0.40)",
        "dropdown": "0 8px 24px -4px rgba(0, 0, 0, 0.50), 0 0 0 1px rgba(255, 255, 255, 0.06)",
        "modal": "0 24px 48px -8px rgba(0, 0, 0, 0.60)",
        "focus": "0 0 0 2px var(--df-brand-primary), 0 0 0 4px var(--df-bg-base)"
      },
      "focus": {
        "ring": {
          "color": "var(--df-brand-primary)",
          "width": "2px",
          "offset": "2px"
        }
      },
      "skeleton": {
        "base": "#1E2638",
        "shimmer": "rgba(255, 255, 255, 0.04)"
      },
      "overlay": "rgba(8, 10, 15, 0.72)",
      "glass": {
        "bg": "rgba(13, 17, 26, 0.72)",
        "blur": "12px"
      },
      "halo": "radial-gradient(1000px circle at 50% -20%, rgba(37, 99, 235, 0.06), transparent 70%)",
      "selection": {
        "barColor": "var(--df-brand-primary)",
        "barWidth": "2px",
        "bg": "var(--df-bg-surface3)"
      }
    },
    "light": {
      "bg": {
        "base": "#F4F6F9",
        "surface1": "#FFFFFF",
        "surface2": "#EDF1F7",
        "surface3": "#E2E8F0"
      },
      "border": {
        "hairline": "#E2E8F0",
        "subtle": "#CBD5E1",
        "medium": "#94A3B8",
        "highlight": "rgba(255, 255, 255, 0.80)"
      },
      "text": {
        "primary": "#0F172A",
        "secondary": "#334155",
        "muted": "#64748B",
        "faint": "#CBD5E1",
        "onBrand": "#FFFFFF"
      },
      "brand": {
        "primary": "#1D4ED8",
        "primaryHover": "#1E40AF",
        "glow": "rgba(29, 78, 216, 0.12)"
      },
      "telemetry": {
        "cyan": "#0284C7",
        "cyanSubtle": "rgba(2, 132, 199, 0.08)"
      },
      "status": {
        "nominal": "#059669",
        "nominalBg": "#ECFDF5",
        "warning": "#B45309",
        "warningBg": "#FFFBEB",
        "critical": "#B91C1C",
        "criticalBg": "#FEF2F2",
        "neutral": "#64748B",
        "neutralBg": "#F1F5F9"
      },
      "shadows": {
        "card": "inset 0 1px 0 0 rgba(255, 255, 255, 0.80), 0 2px 8px -2px rgba(15, 23, 42, 0.06)",
        "dropdown": "0 8px 24px -4px rgba(15, 23, 42, 0.12), 0 0 0 1px rgba(15, 23, 42, 0.06)",
        "modal": "0 24px 48px -8px rgba(15, 23, 42, 0.18)",
        "focus": "0 0 0 2px var(--df-brand-primary), 0 0 0 4px var(--df-bg-base)"
      },
      "focus": {
        "ring": {
          "color": "var(--df-brand-primary)",
          "width": "2px",
          "offset": "2px"
        }
      },
      "skeleton": {
        "base": "#E2E8F0",
        "shimmer": "rgba(255, 255, 255, 0.60)"
      },
      "overlay": "rgba(15, 23, 42, 0.40)",
      "glass": {
        "bg": "rgba(255, 255, 255, 0.80)",
        "blur": "12px"
      },
      "halo": "radial-gradient(1000px circle at 50% -20%, rgba(29, 78, 216, 0.04), transparent 70%)",
      "selection": {
        "barColor": "var(--df-brand-primary)",
        "barWidth": "2px",
        "bg": "var(--df-bg-surface3)"
      }
    }
  },
  "chart": {
    "series": [
      "#3B82F6",
      "#0284C7",
      "#8B5CF6",
      "#D97706",
      "#10B981",
      "#64748B"
    ],
    "seriesLight": [
      "#1D4ED8",
      "#0369A1",
      "#7C3AED",
      "#B45309",
      "#059669",
      "#475569"
    ],
    "grid": {
      "dark": "rgba(148, 163, 184, 0.12)",
      "light": "rgba(15, 23, 42, 0.08)"
    },
    "axisText": {
      "dark": "#94A3B8",
      "light": "#475569"
    },
    "sparklineOpacity": 0.4,
    "tooltip": {
      "bg": { "dark": "#121824", "light": "#FFFFFF" },
      "border": { "dark": "#2A364F", "light": "#E2E8F0" },
      "text": { "dark": "#F8FAFC", "light": "#0F172A" }
    },
    "annotation": {
      "color": { "dark": "#D97706", "light": "#B45309" },
      "labelBg": { "dark": "#121824", "light": "#FFFFFF" }
    }
  }
}

