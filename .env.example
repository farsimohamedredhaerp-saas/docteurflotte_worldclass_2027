# ==============================================================================
# DocteurFlotte — Variables d'environnement pour le développement local
# ==============================================================================
# ATTENTION : Ne commitez jamais de fichier .env réel contenant des secrets.
# Ce fichier sert uniquement de modèle documenté pour le développement local.

# --- Ports Hôte Docker (Sélectionnés hors conflit avec d'autres conteneurs locaux) ---
# Note : 5432, 5433 et 55432 étant déjà utilisés sur cette machine hôte par d'autres projets,
# le port 5434 est retenu par défaut pour PostgreSQL.
POSTGRES_PORT=5434
POSTGRES_USER=docteurflotte
POSTGRES_PASSWORD=docteurflotte_dev_password_local_only
POSTGRES_DB=docteurflotte_dev

# Note : 6379 étant déjà utilisé par un autre projet, le port 6380 est retenu pour Redis.
REDIS_PORT=6380

# --- API NestJS (apps/api) ---
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://docteurflotte:docteurflotte_dev_password_local_only@localhost:5434/docteurflotte_dev
REDIS_URL=redis://localhost:6380

# --- Frontend Web Next.js (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_PORT=3000
